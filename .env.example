# Inovantage Idea Validator — environment variables
#
# Copy to `.env` for local development (`netlify dev` loads it). Only
# placeholders live here. Never commit real values. In Netlify, set these under
# Site configuration → Environment variables, scoped to the right context.
#
# Variables prefixed VITE_ are compiled into the browser bundle and are PUBLIC.
# Everything else is read only by Netlify Functions (server-side).

# ============================================================================
# Frontend (public)
# ============================================================================

# "true" = simulated checkout and report processing, no backend required.
# Anything other than "false" is treated as demo mode. The production build
# refuses to run unless this is exactly "false".
VITE_DEMO_MODE=true

# Draft preservation for the questionnaire. "session" (default) keeps answers
# in sessionStorage for the current tab so a refresh does not lose them;
# "none" keeps them in memory only. localStorage is never used.
VITE_DRAFT_STORAGE=session

# ============================================================================
# Backend: shared
# ============================================================================

# Public origin used in emails, Stripe redirect URLs and worker invocation.
# If unset, Netlify's DEPLOY_PRIME_URL (this deploy) is used, then URL (the
# production site). Set it explicitly per deploy context for custom domains.
APP_URL=https://your-site.netlify.app

# Random salt for hashing client IPs in rate-limit keys. `openssl rand -hex 16`
IP_HASH_SALT=replace-with-random-hex

# Shared secret that authenticates the webhook/dispatcher → background worker
# call. At least 32 characters. `openssl rand -hex 32`
WORKER_SECRET=replace-with-at-least-32-random-characters

# ============================================================================
# Backend: Supabase (server key only; the public key is not used anywhere)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
# Accepts the new-format secret key (sb_secret_...) or the legacy service_role
# JWT. A publishable/anon key is rejected at startup. Netlify Functions only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_placeholder

# ============================================================================
# Backend: owner pilot (no Stripe). Disabled unless PILOT_MODE=true.
# ============================================================================
# "true" turns on /owner/pilot and the pilot-order endpoint. Leave unset for
# the public launch.
PILOT_MODE=false
# Checked server-side only. At least 12 characters. Never a VITE_ variable.
PILOT_OWNER_PASSWORD=replace-with-a-long-private-password
# Signs the owner session cookie. At least 32 characters. `openssl rand -hex 32`
PILOT_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional override of the delivery allowlist (comma separated). Default:
# support@metaphorconsultants.com. Enforced on every pilot send.
# PILOT_ALLOWED_EMAILS=support@metaphorconsultants.com

# ============================================================================
# Backend: Stripe
# ============================================================================
# Use TEST-MODE keys (sk_test_, whsec_ from a test webhook, price_ ids created
# in test mode) until launch. Live charges are never enabled by this code.
STRIPE_SECRET_KEY=sk_test_placeholder
# From the webhook endpoint you create for POST https://<site>/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# One-time Prices, one per product. Amounts must equal src/config/product.ts:
#   standard  = 1700 GBP  (£17 Idea Validation Report)
#   upgrade   = 3500 GBP  (£35 Detailed Report Upgrade, additional)
# The server verifies both at checkout time and rejects a mismatch.
STRIPE_PRICE_ID_STANDARD=price_placeholder_standard
STRIPE_PRICE_ID_UPGRADE=price_placeholder_upgrade

# ============================================================================
# Backend: Anthropic (report research and composition)
# ============================================================================
ANTHROPIC_API_KEY=replace-with-anthropic-key
# Optional model override. Default: claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5
# "anthropic" (default) or "stub". The stub produces labelled placeholder
# output with no research and is REFUSED when CONTEXT=production.
REPORT_GENERATOR=anthropic

# ============================================================================
# Backend: Resend (email)
# ============================================================================
RESEND_API_KEY=re_placeholder
# A verified sender on your Resend domain.
EMAIL_FROM=Inovantage Idea Validator <reports@your-domain.example>
# EMAIL_REPLY_TO=support@your-domain.example
# Optional: receives an alert when a report job exhausts its retries.
# OWNER_ALERT_EMAIL=owner@your-domain.example

# ============================================================================
# Backend: access lifetimes (days)
# ============================================================================
# Ongoing access is the default: emailed report links do not expire and no
# purchase-access expiry is set. These only adjust the secondary links.
# REPORT_ACCESS_DAYS=0          # 0 = no preset expiry; >0 sets report_expires_at at purchase
# TOKEN_TTL_DAYS=30             # links minted on the checkout return page
# RECOVERY_TOKEN_TTL_DAYS=30    # links sent by "Find my report"
