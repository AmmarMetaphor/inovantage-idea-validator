# Inovantage Idea Validator — environment variables
#
# Copy this file to `.env` for local development. Only placeholders live here.
# Never commit real keys. Variables prefixed with VITE_ are exposed to the
# browser bundle, so they must never contain secrets.

# ---- Frontend (public, safe for the browser) ---------------------------------

# "true" = simulated checkout and report processing, no backend required.
# Anything other than "false" is treated as demo mode. Set to "false" only
# once the Netlify Functions below exist and are configured.
VITE_DEMO_MODE=true

# Optional: keep questionnaire answers in sessionStorage for the current tab so
# a page refresh does not lose progress. Off by default because answers can
# include personal financial details. Values: "none" (default) or "session".
VITE_DRAFT_STORAGE=none

# Public Stripe key (pk_test_... / pk_live_...). Public by design, still a
# placeholder here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# ---- Backend (Netlify Functions only — never prefixed with VITE_) ------------
# These are read by server-side functions that are not part of this frontend
# release. Leave as placeholders.

STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
EMAIL_PROVIDER_API_KEY=placeholder
REPORT_STORAGE_BUCKET=placeholder
